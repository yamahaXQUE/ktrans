# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/call_tasks

# Docker Compose: only the application port is published.
APP_PORT=8080
APP_BIND_ADDRESS=0.0.0.0
POSTGRES_DB=call_tasks
POSTGRES_USER=call_tasks
POSTGRES_PASSWORD=replace-this-password
WEB_CONCURRENCY=1
DB_STARTUP_TIMEOUT=60
BITRIX_SYNC_INTERVAL_SECONDS=300
BITRIX_DIRECTORY_SYNC_INTERVAL_SECONDS=3600
BITRIX_CALL_LOOKBACK_HOURS=48
BITRIX_SYNC_MAX_RECORDS_PER_OPERATOR=1000
# Optional PEM CA used only by the frontend build stage behind TLS inspection.
NPM_CA_FILE=deploy/no-corporate-ca.pem

# Incoming webhook: keep the complete URL only on the backend.
BITRIX_WEBHOOK_URL=https://bitrix.example/rest/user/webhook-secret/
BITRIX_TLS_COMPATIBILITY=false
BITRIX_ALLOWED_PORTALS=bitrix.example
BITRIX_ACCESS_BYPASS_USER_IDS=255747
BITRIX_OPERATOR_DEPARTMENT_ID=82

# Fallback route for native tasks when the operator selects no department.
BITRIX_TASK_DEFAULT_DEPARTMENT_ID=82
BITRIX_TASK_ADD_METHOD=task.item.add

# Session/auth. Keep secure=true behind the HTTPS corporate proxy.
DEV_BITRIX_USER_ID=
SESSION_COOKIE_SECURE=true
FORWARDED_ALLOW_IPS=*
# Set SESSION_COOKIE_SECURE=false only for plain-HTTP local development.

# Production overlay sources these values directly from the deployment
# environment as Docker secrets; do not save real values in this file:
# KULIKOV_DATABASE_URL=postgresql://call_tasks:...@db:5432/call_tasks
# OPENAI_API_KEY=sk-proj-...

# Neural call analysis worker.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPT_ENHANCEMENT_MODEL=gpt-5.6-luna
OPENAI_TASK_MODEL=gpt-5.6-luna
ANALYSIS_POLL_INTERVAL_SECONDS=60
ANALYSIS_LOOKBACK_HOURS=24
ANALYSIS_MIN_DURATION_SECONDS=10
ANALYSIS_MAX_RECORDING_BYTES=25000000
ANALYSIS_STALE_PROCESSING_MINUTES=30
# Захарова Анастасия, Невечеря Светлана,
# Рустамова Ранохан, Лазаревич Регина.
ANALYSIS_AUTO_BITRIX_USER_IDS=43654,13,55520,10
